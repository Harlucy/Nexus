# SubWeb (Nexus) 配置
# 复制此文件为 .env 并填入你的配置

# ========== 服务器地址 ==========
# 你的服务器IP或域名
SERVER_IP=your-server-ip

# Subconverter API
API_URL=http://${SERVER_IP}:25500

# YamlForge
YAMLFORGE_BACKEND=http://${SERVER_IP}:25501
YAMLFORGE_API_KEY=your-yamlforge-api-key

# Shlink 短链接
SHLINK_BACKEND=http://${SERVER_IP}:25502
SHLINK_API_KEY=your-shlink-api-key
SHLINK_PUBLIC_URL=http://${SERVER_IP}:25502
SHLINK_DOMAIN=${SERVER_IP}
SHLINK_HTTPS=false

# 配置服务器
CONFIG_SERVER=http://${SERVER_IP}:25503

# ========== 前端配置 ==========
# Web界面端口
WEB_PORT=25504

# 网站标题
SITE_NAME=Nexus
